<mxfile host="app.diagrams.net" agent="reference-architecture" version="22.1.16">
  <diagram name="useClass anti-pattern" id="singleton-3">
    <mxGraphModel dx="900" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="450" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="⚠ useClass anti-pattern  →  TWO instances, divergent state" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="820" height="30" as="geometry" />
        </mxCell>

        <!-- Callers -->
        <mxCell id="caller_plugin" value="Plugin&#10;inject(DASHBOARD_STATE_STORE)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="caller_framework" value="Other framework code&#10;inject(DashboardStateStore)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Two divergent instances -->
        <mxCell id="instance_1" value="Instance #1&#10;(behind the TOKEN)&#10;separate _widgets, _loading, …" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="560" y="100" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="instance_2" value="Instance #2&#10;(behind the CLASS)&#10;separate _widgets, _loading, …" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="560" y="220" width="260" height="100" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e_plugin" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#b85450" edge="1" parent="1" source="caller_plugin" target="instance_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_fw" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#b85450" edge="1" parent="1" source="caller_framework" target="instance_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Divider showing they don't share state -->
        <mxCell id="divider" value="≠&#10;different objects&#10;different signals" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="380" y="170" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="caption" value="{ provide: DASHBOARD_STATE_STORE, useClass: DashboardStateStore }&#10;tells DI to instantiate a SECOND DashboardStateStore behind the token. The plugin sees one set of signals,&#10;the framework sees another. The UI silently diverges. Always use useExisting unless you specifically want a fresh copy." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="40" y="350" width="820" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
