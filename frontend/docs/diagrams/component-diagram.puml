@startuml component-diagram
title Workspace components and dependency rules
skinparam shadowing false
skinparam componentStyle rectangle
skinparam linetype ortho

package "framework (Angular library)" as fw {
  component "*.contract.ts\n(interfaces +\nInjectionTokens)" as fw_contracts
  component "*.store.ts\n(real @Injectable\nimplementations)" as fw_impl
  fw_impl ..> fw_contracts : implements
}

package "plugin (Angular library)" as pl {
  component "Dashboard\n(@Component, standalone)" as pl_cmp
  note right of pl_cmp
    Imports ONLY the token + interface
    from framework. Never imports any
    concrete framework class.
  end note
}

package "app (Angular application)" as app {
  component "appConfig\n+ App shell\n(Material toolbar/card)" as app_cmp
  note right of app_cmp
    { provide: DASHBOARD_STATE_STORE,
      useExisting: DashboardStateStore }
  end note
}

package "plugin-host (Angular app)" as ph {
  component "appConfig" as ph_cfg
  component "DashboardStateStoreMock" as ph_mock
  component "playwright-bridge\n(window.__pluginHostBridge)" as ph_bridge
  component "e2e/\n(POM + tests)" as ph_e2e
  note right of ph_cfg
    { provide: DASHBOARD_STATE_STORE,
      useExisting: DashboardStateStoreMock }
  end note
}

' allowed dependencies
pl_cmp   --> fw_contracts : token + interface only

app_cmp  --> fw_impl       : useExisting alias
app_cmp  --> pl_cmp        : renders <lib-dashboard/>

ph_cfg   --> fw_contracts  : token
ph_cfg   --> ph_mock       : provides
ph_mock  --> fw_contracts  : implements IDashboardStateStore
ph_mock  --> ph_bridge     : recordCall +\nregisterController
ph_e2e   --> ph_bridge     : page.evaluate
ph_e2e   --> pl_cmp        : drives DOM\n(via POM locators)

' forbidden dependency (called out)
pl_cmp -[#red,dashed]-> fw_impl : <<forbidden>>\nwould fuse plugin\nto real implementation

@enduml
