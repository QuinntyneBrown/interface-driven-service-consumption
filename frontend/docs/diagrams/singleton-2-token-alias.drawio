<mxfile host="app.diagrams.net" agent="reference-architecture" version="22.1.16">
  <diagram name="Singleton — token alias to same instance" id="singleton-2">
    <mxGraphModel dx="900" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="450" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="useExisting alias  →  two keys, ONE instance" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="820" height="30" as="geometry" />
        </mxCell>

        <!-- Callers -->
        <mxCell id="caller_plugin" value="Plugin&#10;inject(DASHBOARD_STATE_STORE)&#10;[asks for the TOKEN]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="caller_framework" value="Other framework code&#10;inject(DashboardStateStore)&#10;[asks for the CLASS]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="240" height="80" as="geometry" />
        </mxCell>

        <!-- Single instance -->
        <mxCell id="instance" value="DashboardStateStore&#10;(ONE cached instance&#10;on the root injector)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="580" y="160" width="240" height="120" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e_plugin" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.3;strokeColor=#82b366;dashed=1" edge="1" parent="1" source="caller_plugin" target="instance">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_plugin_lbl" value="resolved via useExisting alias" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="290" y="130" width="280" height="20" as="geometry" />
        </mxCell>

        <mxCell id="e_fw" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.7;strokeColor=#82b366" edge="1" parent="1" source="caller_framework" target="instance">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_fw_lbl" value="direct class lookup" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="290" y="290" width="280" height="20" as="geometry" />
        </mxCell>

        <mxCell id="caption" value="{ provide: DASHBOARD_STATE_STORE, useExisting: DashboardStateStore }&#10;does NOT create a new instance — it tells the injector &quot;the token is just another name for the class.&quot;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="40" y="370" width="820" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
