@startuml sequence-plugin-to-framework
title Direction 1: plugin → framework (call recording)
skinparam shadowing false
skinparam sequenceMessageAlign center

actor "Playwright\n(Node)"     as Test
participant "page.evaluate\n(CDP bridge)" as Eval
participant "DOM\n(plugin-host page)" as DOM
participant "Dashboard\n(plugin component)"  as Dashboard
participant "DashboardStateStoreMock\n(@Injectable provided in: 'root')"   as Mock
participant "window.__pluginHostBridge\n(IPlaywrightBridge)" as Bridge

== arrange ==
Test -> Eval : page.click(selectButton('w1'))
Eval -> DOM : dispatch click
activate DOM
DOM -> Dashboard : (event handler) store.selectWidget('w1')
deactivate DOM
activate Dashboard
note right of Dashboard
  Plugin only knows
  IDashboardStateStore via the
  DASHBOARD_STATE_STORE token —
  never the mock concretely.
end note
Dashboard -> Mock : selectWidget('w1')
deactivate Dashboard
activate Mock

== record ==
Mock -> Bridge : recordCall('selectWidget', ['w1'])
activate Bridge
Bridge -->> Bridge : push { method, args, ts } to calls[]
deactivate Bridge

Mock -> Mock : _selectedWidgetId.set('w1')
note right of Mock
  Local signal update keeps the
  UI in a believable state — but
  the assertion target is the
  recorded call, not the DOM.
end note
deactivate Mock

== assert ==
Test -> Eval : page.evaluate(\n  m => bridge.callsFor(m),\n  'selectWidget')
activate Eval
Eval -> Bridge : callsFor('selectWidget')
activate Bridge
Bridge --> Eval : [ { method: 'selectWidget',\n           args: ['w1'], ts: ... } ]
deactivate Bridge
Eval --> Test : structured-cloned\nresult array
deactivate Eval

Test -> Test : expect(calls).toHaveLength(1)\nexpect(calls[0].args).toEqual(['w1'])

@enduml
