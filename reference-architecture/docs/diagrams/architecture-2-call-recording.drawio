<mxfile host="app.diagrams.net" agent="reference-architecture" version="22.1.16">
  <diagram name="Call recording flow" id="arch-2">
    <mxGraphModel dx="900" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Direction 1: plugin → framework  (the test reads what the plugin called)" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="820" height="30" as="geometry" />
        </mxCell>

        <!-- Top row: forward path -->
        <mxCell id="b1" value="1. user click&#10;(page.click)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="2. Plugin component&#10;handles click" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="220" y="120" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="3. Mock&#10;.selectWidget('w1')" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="420" y="120" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="4. bridge.calls[]&#10;(append the call)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="620" y="120" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Bottom row: assert path -->
        <mxCell id="b5" value="5. Test reads&#10;page.evaluate(\n  () => bridge.callsFor('selectWidget'))" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="6. expect(calls[0].args).toEqual(['w1'])" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="380" y="250" width="320" height="60" as="geometry" />
        </mxCell>

        <!-- Forward edges -->
        <mxCell id="e1" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="b1" target="b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="b2" target="b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2lbl" value="store.selectWidget('w1')" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="380" y="90" width="160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="b3" target="b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3lbl" value="recordCall(method, args)" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="580" y="90" width="160" height="20" as="geometry" />
        </mxCell>

        <!-- Bridge → test (read) -->
        <mxCell id="e4" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;strokeColor=#b85450" edge="1" parent="1" source="b4" target="b5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4lbl" value="read calls[] later" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="320" y="200" width="160" height="20" as="geometry" />
        </mxCell>

        <!-- 5 → 6 -->
        <mxCell id="e5" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="b5" target="b6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="caption" value="The mock is the only thing that writes to bridge.calls[]. The test reads from it later via page.evaluate.&#10;Asserting on the call log proves the plugin called the framework's INTERFACE correctly — not what the framework then did." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="40" y="350" width="820" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
