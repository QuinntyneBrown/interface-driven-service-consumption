<mxfile host="app.diagrams.net" agent="reference-architecture" version="22.1.16">
  <diagram name="State driving flow" id="arch-3">
    <mxGraphModel dx="900" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Direction 2: framework → plugin  (the test pushes data, the UI reacts)" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="820" height="30" as="geometry" />
        </mxCell>

        <!-- 6 boxes top to bottom -->
        <mxCell id="s1" value="1. Test calls&#10;dashboard.setWidgets([...])" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="320" y="70" width="260" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="2. page.evaluate(fn, widgets)&#10;widgets are structured-cloned to the browser" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="320" y="140" width="260" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="3. bridge.controller('dashboard')&#10;.setWidgets(next)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="320" y="210" width="260" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s4" value="4. mock.setWidgets&#10;wraps in NgZone.run(() ⇒ _widgets.set(next))" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fad7ac;strokeColor=#b46504;fontSize=11;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="320" y="280" width="260" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s5" value="5. Signal change&#10;Angular schedules an OnPush tick" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="320" y="350" width="260" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s6" value="6. Plugin re-renders&#10;Test sees new DOM via locators" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="320" y="420" width="260" height="50" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e12" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e23" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e34" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e45" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e56" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="s5" target="s6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- side note for NgZone -->
        <mxCell id="zone_note" value="Why NgZone.run?&#10;page.evaluate runs OUTSIDE Angular's zone.&#10;Without zone.run the signal would update&#10;but the OnPush view would not tick — test&#10;would see stale DOM." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="620" y="270" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="zone_arrow" style="endArrow=classic;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;strokeColor=#b46504;dashed=1" edge="1" parent="1" source="zone_note" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
