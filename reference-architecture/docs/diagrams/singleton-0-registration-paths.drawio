        </mxCell>
        <mxCell id="e_b" edge="1" parent="1" source="approach_b" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.7;strokeColor=#82b366" target="instance">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_b_lbl" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2" value="registers with root" vertex="1">
