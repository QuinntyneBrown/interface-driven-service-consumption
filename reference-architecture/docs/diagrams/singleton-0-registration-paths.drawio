  <diagram name="Two ways to register a singleton" id="singleton-0">
    <mxGraphModel dx="1007" dy="672" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="450" math="0" shadow="0">
      <root>
