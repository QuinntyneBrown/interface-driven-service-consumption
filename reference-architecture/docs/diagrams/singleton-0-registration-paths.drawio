        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1" value="Two ways to register — both land on the root injector and produce a singleton" vertex="1">
          <mxGeometry height="30" width="820" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="approach_a_label" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;spacingLeft=4" value="Approach A — declare on the class" vertex="1">
