        </mxCell>
        <mxCell id="caption" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2" value="Either path tells Angular &quot;put this registration on the root injector.&quot; The root injector is created once during&#xa;bootstrapApplication and caches one instance per registered token. So both approaches → singleton." vertex="1">
          <mxGeometry height="40" width="820" x="40" y="380" as="geometry" />
        </mxCell>
        <mxCell id="zvxBNGYV8sM7XEEsRoSe-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;ONE cached instance, one set of WritableSignals, lives until the page unloads&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="140" x="630" y="250" as="geometry" />
        </mxCell>
      </root>
