<mxfile host="app.diagrams.net" agent="reference-architecture" version="22.1.16">
  <diagram name="Two processes joined by the bridge" id="arch-1">
    <mxGraphModel dx="900" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="380" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Two processes. One shared object on window. That's the whole picture." style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="820" height="30" as="geometry" />
        </mxCell>

        <!-- Node side -->
        <mxCell id="node" value="Node (Playwright runner)&#10;&#10;your test files run here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="240" height="160" as="geometry" />
        </mxCell>

        <!-- Browser side -->
        <mxCell id="browser" value="Browser (the page)&#10;&#10;Angular app + plugin run here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="620" y="120" width="240" height="160" as="geometry" />
        </mxCell>

        <!-- Bridge in the middle -->
        <mxCell id="bridge" value="window.__pluginHostBridge&#10;&#10;the only object both sides know about" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;align=center;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="340" y="140" width="240" height="120" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e_node_bridge" style="endArrow=classic;startArrow=classic;startFill=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#9673a6" edge="1" parent="1" source="node" target="bridge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_node_lbl" value="page.evaluate(...)" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="280" y="170" width="120" height="20" as="geometry" />
        </mxCell>

        <mxCell id="e_bridge_browser" style="endArrow=classic;startArrow=classic;startFill=1;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#82b366" edge="1" parent="1" source="bridge" target="browser">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_bridge_browser_lbl" value="just a JS object on window" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="540" y="170" width="160" height="20" as="geometry" />
        </mxCell>

        <mxCell id="caption" value="Playwright (Node) cannot directly call your services. The bridge is a small object the plugin-host installs on&#10;window before bootstrap. Your tests reach it through page.evaluate; the mock writes to it from inside the app." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="820" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
